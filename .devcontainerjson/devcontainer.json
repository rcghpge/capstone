k{
  "name": "Capstone Binder",
  "image": "rcdpge/capstone-binder:latest",
  "features": {
    "ghcr.io/devcontainers/features/python:1": {}
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "bierner.markdown-preview-github-styles",
        "yzhang.markdown-all-in-one"
      ],
      "settings": {
        "markdown.styles": ["https://cdn.jsdelivr.net/npm/github-markdown-css/github-markdown.css"]
      }
    }
  },
  "forwardPorts": [8888, 3000],
  "postCreateCommand": "apt-get update && apt-get install -y -qq git && pip install -e .[dev] && jupyter lab --generate-config --allow-root && echo 'c.ServerApp.ip = \"0.0.0.0\"' >> ~/.jupyter/jupyter_lab_config.py",
  "remoteUser": "jovyan",
  "overrideFeatureInstallOrder": ["python"]
}

