{
  "name": "Capstone Binder",
  "build": { "dockerfile": "../Dockerfile", "context": ".." },
  "workspaceFolder": "/workspaces/capstone",
  "postCreateCommand": "bash .devcontainer/post-build.sh",
  "features": {},
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-toolsai.jupyter",
        "ms-python.python",
        "bierner.markdown-preview-github-styles",
        "yzhang.markdown-all-in-one"
      ],
      "settings": {
        "markdown.styles": [
          "https://cdn.jsdelivr.net/npm/github-markdown-css/github-markdown.css"
        ],
        "python.defaultInterpreterPath": "/opt/conda/bin/python",
        "explorer.autoReveal": true,
        "explorer.compactFolders": false,
        "files.exclude": {
          "**/__pycache__/**": true,
          "**/.pixi/**": true
        },
        "files.watcherExclude": {
          "**/__pycache__/**": true
        }
      },
      "codespaces": {
        "openFiles": ["README.md"]
      }
    }
  },
  "forwardPorts": [8888, 3000, 3666],
  "portsAttributes": {
    "3666": {
      "label": "JupyterLab",
      "onAutoForward": "notify"
    }
  },
  "remoteUser": "jovyan"
}
