{
  "name": "Capstone Binder",
  "build": { "dockerfile": "../Dockerfile", "context": ".." },
  "workspaceFolder": "/workspaces/capstone",
  "postStartCommand": "sleep 10 && code .",
  "postCreateCommand": "bash .devcontainer/post-build.sh",
  "features": {},
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-toolsai.jupyter",
        "ms-python.python",
        "bierner.markdown-preview-github-styles",
        "yzhang.markdown-all-in-one"
      ],
      "settings": {
        "markdown.styles": [
          "https://cdn.jsdelivr.net/npm/github-markdown-css/github-markdown.css"
        ],
        "python.defaultInterpreterPath": "/opt/conda/bin/python"
      }
    }
  },
  "forwardPorts": [8888, 3000, 3666],
  "portsAttributes": {
    "3666": {
      "label": "JupyterLab",
      "onAutoForward": "notify"
    }
  },
  "remoteUser": "jovyan"
}
